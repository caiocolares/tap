# syntax=docker/dockerfile:1
#
# Imagem com suporte a GPU NVIDIA (CUDA). Usa o torch resolvido pelo próprio
# uv.lock, cujas dependências nvidia/cuda (cuda-bindings, cuda-toolkit, ...)
# já trazem as bibliotecas de runtime via pip — não é necessária uma imagem
# base com o CUDA Toolkit instalado, só o driver NVIDIA no host/nó do k8s.
#
# Requisitos do cluster:
#   - Nós com GPU NVIDIA + NVIDIA device plugin instalado
#   - No pod/Job: resources.limits: {"nvidia.com/gpu": 1}
#
# Build:  docker build -f Dockerfile.gpu -t audio-to-text:gpu .
# Run:    docker run --rm --gpus all -p 8000:8000 -e HF_TOKEN=hf_xxx \
#           -e WHISPER_DEVICE=cuda audio-to-text:gpu
#         curl -X POST --data-binary @audio.mp3 http://localhost:8000/transcricao/txt -o resultado.txt
#
# Para rodar a CLI em vez do servidor HTTP (ex. num Job do k8s), sobrescreva
# o entrypoint: docker run --rm --gpus all --entrypoint python \
#   -v "$PWD/dados:/data" audio-to-text:gpu transcribe.py /data/audio.mp3 \
#   --device cuda --output /data/resultado

########################
# Builder
########################
FROM ghcr.io/astral-sh/uv:python3.13-bookworm-slim AS builder

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never

WORKDIR /app

# Instala exatamente o que está no lock, incluindo torch com suporte CUDA.
COPY pyproject.toml uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-install-project --no-dev

########################
# Runtime
########################
FROM python:3.13-slim-bookworm AS runtime

RUN apt-get update && apt-get install -y --no-install-recommends \
        ffmpeg \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd --gid 1000 app \
    && useradd --uid 1000 --gid app --create-home --shell /usr/sbin/nologin app

WORKDIR /app

ENV PATH="/app/.venv/bin:$PATH" \
    HOME=/home/app \
    HF_HUB_CACHE=/home/app/.cache/huggingface \
    PYTHONUNBUFFERED=1

COPY --from=builder --chown=app:app /app/.venv /app/.venv
COPY --chown=app:app transcribe.py server.py storage.py mail.py worker.py ./

# Compatibilidade com OpenShift: a SCC `restricted` roda o container com um
# UID arbitrário (não necessariamente 1000), sempre pertencente ao grupo 0.
# Deixar /app e $HOME graváveis pelo grupo 0 evita falhas de permissão
# (ex. ao baixar/cachear modelos em $HF_HUB_CACHE).
RUN chgrp -R 0 /app /home/app \
    && chmod -R g=u /app /home/app

USER app

# HF_TOKEN é opcional em runtime — injete via Secret do k8s para habilitar a
# diarização; sem ele o servidor transcreve normalmente, sem identificar
# speakers. Defina WHISPER_DEVICE=cuda para usar a GPU (WHISPER_MODEL/
# WHISPER_LANGUAGE também são configuráveis via env var — veja README).
EXPOSE 8000
ENTRYPOINT ["uvicorn", "server:app", "--host", "0.0.0.0", "--port", "8000"]
