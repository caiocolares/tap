# API leve: não instala Torch/Whisper/Pyannote. Inferência assíncrona roda no worker.
FROM ghcr.io/astral-sh/uv:python3.13-bookworm-slim AS builder
ENV UV_LINK_MODE=copy UV_COMPILE_BYTECODE=1
WORKDIR /app
COPY pyproject.toml uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv uv sync --frozen --only-group api

FROM python:3.13-slim-bookworm
RUN useradd --uid 1000 --create-home app
WORKDIR /app
ENV PATH="/app/.venv/bin:$PATH" PYTHONUNBUFFERED=1 API_ASYNC_ONLY=true
COPY --from=builder /app/.venv /app/.venv
COPY server.py settings.py storage.py jobs.py processing.py transcribe.py ./
COPY migrations/ ./migrations/
USER app
EXPOSE 8000
ENTRYPOINT ["uvicorn", "server:app", "--host", "0.0.0.0", "--port", "8000"]
