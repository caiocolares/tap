HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Gere um segredo antes de iniciar a API: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_TTL_SECONDS=86400
AUTH_WINDOW_SECONDS=900
AUTH_MAX_REQUESTS=3
AUTH_IP_MAX_REQUESTS=20
WHISPER_MODEL=small

# SMTP obrigatório para emitir códigos de acesso. Notificações usam serviço próprio.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=nao-responda@exemplo.com
SMTP_SECURITY=starttls
SMTP_TIMEOUT_SECONDS=30

# Limites por processo (upload padrão: 100 MiB; conversão: 5 minutos).
MAX_UPLOAD_BYTES=104857600
MAX_PENDING_JOBS=8
FFMPEG_TIMEOUT_SECONDS=300

# Retenção de metadados terminais no PostgreSQL; limpeza periódica.
JOB_TTL_SECONDS=3600
JOB_CLEANUP_INTERVAL_SECONDS=60

# API assíncrona durável: exige PostgreSQL e MinIO/S3 compartilhados.
JOBS_DATABASE_URL=postgresql://tap:tap_local@localhost:5432/tap
MAX_QUEUED_JOBS=100
JOB_MAX_ATTEMPTS=3
JOB_LEASE_SECONDS=60
JOB_HEARTBEAT_SECONDS=10
JOB_RETRY_SECONDS=5
WORKER_POLL_SECONDS=1
# A imagem Dockerfile.api define true. Imagens completas preservam a rota síncrona.
API_ASYNC_ONLY=false

# Object storage (MinIO/S3) para os resultados dos jobs assíncronos.
# Sem MINIO_ENDPOINT e JOBS_DATABASE_URL, somente a CLI/rota síncrona funcionam.
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=audio-to-text
MINIO_SECURE=false

# Usados apenas pelo docker-compose.yml para inicializar o container do MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Credenciais locais do PostgreSQL usadas pelo docker-compose.yml.
POSTGRES_USER=tap
POSTGRES_PASSWORD=tap_local
POSTGRES_DB=tap
