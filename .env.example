HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Object storage (MinIO/S3) para os resultados dos jobs assíncronos.
# Deixe MINIO_ENDPOINT vazio para rodar sem storage compartilhado (comportamento
# original: resultado fica só no disco local do processo).
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=audio-to-text
MINIO_SECURE=false

# Usados apenas pelo docker-compose.yml para inicializar o container do MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
